# ── CNH Service — configuration ─────────────────────────────────
# Copy this file to `.env` and adjust values, then (re)start the app:
#   cp .env.example .env   (Linux/macOS)   |   copy .env.example .env   (Windows)
#
# Variables loaded by server.js at startup (no npm dependency needed).
# All values are optional — the app works with sensible defaults.

# Port the Node server listens on (default 3000).
# Behind Nginx, keep this internal (e.g. 3000) and let Nginx proxy to it.
PORT=3000

# NODE_ENV=production

# ── Turso (managed database, required on Vercel) ──
# On Vercel the filesystem is read-only/ephemeral, so the app uses Turso
# (libSQL/SQLite) for persistent storage. Without these vars, the app
# falls back to the local cnh_service.db file (local dev / VPS).
# TURSO_DATABASE_URL=libsql://cnh-service-xxxx.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# ── Admin security ──
# Initial admin password (REQUIRED on first deploy, >=12 characters).
# If unset, no admin is created and a warning is logged.
# ADMIN_INITIAL_PASSWORD=...

# ── Hardening tips ──
# Trusted origins for CORS — default allows all origins:
# CORS_ORIGIN=https://cnhservices.ca,https://www.cnhservices.ca

# ── Email notifications (optional) ──
# Provider: 'resend' or 'brevo'
# MAIL_PROVIDER=resend
# MAIL_API_KEY=...
# MAIL_FROM="CNH Service <noreply@cnhservices.ca>"
# NOTIFY_TO=owner@example.com
# NOTIFY_TO_NAME="CNH Admin"

# ── Data retention (Loi 25) ──
# Months to retain data before purge (default 36). Used by scripts/purge-old-data.js
# PURGE_RETENTION_MONTHS=36